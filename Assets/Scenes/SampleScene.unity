  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Talk
  lines:
  - speaker: "\uCD0C\uC7A5"
    text: "\uC6B0\uB9AC \uB9C8\uC744\uC5D0 \uC628 \uAC78 \uD658\uC601\uD574.\n\uC774
      \uC9D1\uC774 \uBC14\uB85C \uB108\uC758 \uC9D1\uC774\uB780\uB2E4."
  - speaker: "\uB098"
    text: "\uC624... \uC88B\uC740\uB370\uC694?\n\uADFC\uB370 \uC65C \uC800\uD76C
      \uC9D1\uB9CC \uC788\uB294 \uAC70\uC8E0?"
  - speaker: "\uCD0C\uC7A5"
    text: "\uB0A8\uC740 \uC9D1\uC774 \uC5EC\uAE30\uBC16\uC5D0 \uC5C6\uC5B4\uC11C
      \uADF8\uB798^^\n\uB9C8\uC744\uD558\uACE0 \uAC78\uC5B4\uC11C 10\uBD84\uBC16\uC5D0
      \uC548 \uAC78\uB824~~"
  prompt: {fileID: 861065407}
  dialogueBox: {fileID: 1224488469}
